generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String         @db.Uuid
  creator_id String         @db.Uuid
  method     payment_method
  status     payment_status @default(PENDING)

  // Existing (fiat/wallet/stripe)
  amount_cents               Int
  currency                   String    @default("PEN")
  payer_name                 String?
  payer_email                String?
  stripe_checkout_session_id String?
  stripe_payment_intent_id   String?
  stripe_event_id            String?
  wallet_operation_code      String?
  wallet_report_note         String?
  wallet_evidence_url        String?
  reported_at                DateTime? @db.Timestamptz(6)
  confirmed_at               DateTime? @db.Timestamptz(6)
  confirmed_by_user_id       String?   @db.Uuid

  // --- BTC (opcionales, no rompen Stripe/Yape/Plin) ---
  btc_network                btc_network?
  btc_address                String?
  btc_amount_sats            BigInt?
  btc_received_sats          BigInt       @default(0)
  btc_txid                   String?
  btc_confirmations          Int          @default(0)
  btc_required_confirmations Int          @default(1)
  btc_expires_at             DateTime?    @db.Timestamptz(6)
  btc_detected_at            DateTime?    @db.Timestamptz(6)

  // --- BTC fiat-first (rate lock audit) ---
  btc_fx_rate        Decimal?  @db.Decimal(18, 8)
  btc_rate_locked_at DateTime? @db.Timestamptz(6)
  btc_rate_provider  String?

  // --- Non-custodial custody discriminator (DB-002 D14). Immutable after creation (enforced by trigger). No default: callers must classify explicitly. ---
  receiving_model receiving_model

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  users_payments_confirmed_by_user_idTousers users?   @relation("payments_confirmed_by_user_idTousers", fields: [confirmed_by_user_id], references: [id], onUpdate: NoAction)
  users_payments_creator_idTousers           users    @relation("payments_creator_idTousers", fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products                                   products @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  payment_link_id String?        @db.Uuid
  payment_links   payment_links? @relation(fields: [payment_link_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  payment_btc_txs       payment_btc_txs[]
  payment_notifications payment_notifications[]

  // DB-002 attribution lives on the allocation (UNIQUE(payment_id)); no version FK on payments.
  wallet_address_allocation wallet_address_allocations?
  // DB-004 lazy 1:1 reconciliation projection.
  payment_reconciliation    payment_reconciliation?

  // Si luego quieres endurecer para evitar reutilizar address en el mismo network:
  // @@unique([btc_network, btc_address], map: "uq_payments_btc_network_address")

  @@index([payment_link_id], map: "idx_payments_payment_link_id")
  @@index([creator_id, created_at(sort: Desc)], map: "idx_payments_creator_created_at")
  @@index([method], map: "idx_payments_method")
  @@index([product_id, created_at(sort: Desc)], map: "idx_payments_product_created_at")
  @@index([status], map: "idx_payments_status")
  // BTC indexes
  @@index([btc_address], map: "idx_payments_btc_address")
  @@index([btc_txid], map: "idx_payments_btc_txid")
  @@index([btc_expires_at], map: "idx_payments_btc_expires_at")
  @@index([status, btc_expires_at], map: "idx_payments_status_btc_expires_at")
  @@index([btc_rate_locked_at], map: "idx_payments_btc_rate_locked_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id    String          @db.Uuid
  title         String
  message       String
  metadata_json Json?
  amount_cents  Int
  currency      String          @default("PEN")
  active        Boolean         @default(true)
  yape_phone    String?
  plin_phone    String?
  yape_qr_url   String?
  plin_qr_url   String?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  payments      payments[]
  users         users           @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment_links payment_links[]

  @@index([creator_id, active], map: "idx_products_creator_active")
  @@index([creator_id], map: "idx_products_creator_id")
}

model users {
  id                                            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                         String          @unique
  handle                                        String          @unique
  display_name                                  String?
  created_at                                    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at                                    DateTime        @default(now()) @db.Timestamptz(6)
  payments_payments_confirmed_by_user_idTousers payments[]      @relation("payments_confirmed_by_user_idTousers")
  payments_payments_creator_idTousers           payments[]      @relation("payments_creator_idTousers")
  products                                      products[]
  sessions                                      sessions[]
  payment_links                                 payment_links[]

  merchant_wallets            merchant_wallets?
  wallet_audit_events         wallet_audit_events[]
  reconciliation_audit_events reconciliation_audit_events[]
}

model login_codes {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String
  code_hash   String
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  attempts    Int       @default(0)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([email, created_at(sort: Desc)], map: "idx_login_codes_email_created_at")
  @@index([email, expires_at], map: "idx_login_codes_email_expires_at")
}

model sessions {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String   @db.Uuid
  session_token_hash String
  expires_at         DateTime @db.Timestamptz(6)
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, expires_at], map: "idx_sessions_user_expires_at")
  @@index([session_token_hash], map: "idx_sessions_token_hash")
}

model payment_links {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id String @db.Uuid
  product_id String @db.Uuid

  token  String  @unique
  active Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  // relations
  products products   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users      @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments payments[]

  @@index([creator_id, active], map: "idx_payment_links_creator_active")
  @@index([product_id], map: "idx_payment_links_product_id")
  @@index([creator_id], map: "idx_payment_links_creator_id")
}

model payment_btc_txs {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id    String   @db.Uuid
  txid          String
  vout_index    Int
  amount_sats   BigInt
  detected_at   DateTime @db.Timestamptz(6)
  confirmations Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  // --- DB-004 on-chain observation evidence (additive; legacy rows keep NULL). ---
  first_seen_at      DateTime?               @db.Timestamptz(6)
  first_seen_source  String?
  block_hash         String?
  block_height       BigInt?
  observation_status btc_observation_status?

  payments payments @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([payment_id, txid, vout_index], map: "uq_payment_btc_txs_pid_txid_vout")
  // DB-004 D9: global outpoint identity — an outpoint belongs to at most one payment.
  @@unique([txid, vout_index], map: "uq_payment_btc_txs_txid_vout")
  @@index([payment_id], map: "idx_payment_btc_txs_payment_id")
}

/// One notification record per (payment, event). Idempotency via unique constraint.
model payment_notifications {
  id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id String                      @db.Uuid
  event      payment_notification_event
  recipient  String
  status     payment_notification_status @default(PENDING)
  attempts   Int                         @default(0)
  last_error String?
  sent_at    DateTime?                   @db.Timestamptz(6)
  created_at DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at DateTime                    @updatedAt @db.Timestamptz(6)

  payments payments @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([payment_id, event], map: "uq_payment_notifications_pid_event")
  @@index([status, created_at], map: "idx_payment_notifications_status_created")
}

enum payment_method {
  CARD
  YAPE
  PLIN
  BTC_ONCHAIN
}

enum payment_status {
  PENDING
  AWAITING_PAYMENT
  SEEN_IN_MEMPOOL
  CONFIRMING
  CONFIRMED
  EXPIRED
  FAILED
}

enum btc_network {
  MAINNET
  TESTNET
  SIGNET
  REGTEST
}

enum payment_notification_event {
  SEEN_IN_MEMPOOL
  CONFIRMED
  EXPIRED
}

enum payment_notification_status {
  PENDING
  SENT
  FAILED
}

// ============================================================================
// Non-custodial custody plane (DB-001..DB-005). Additive; legacy CARD/YAPE/PLIN
// and SHARED_CUSTODIAL Bitcoin payments are untouched.
// ============================================================================

// --- DB-001 wallet lineage enums ---
enum wallet_lifecycle {
  ACTIVE
  RETIRED
}

enum wallet_script_type {
  P2WPKH
}

// --- DB-002 custody discriminator ---
enum receiving_model {
  SHARED_CUSTODIAL
  NON_CUSTODIAL_DERIVED
}

// --- DB-003 recovery + monitoring enums ---
enum recovery_state {
  RECOVERY_REQUIRED
  RECONCILING
  READY
  RECOVERY_FAILED
}

/// CLOSED vocabulary (DB-003). Physically restricted - do not extend without an ADR.
enum recovery_state_reason {
  INITIAL_ESTABLISHMENT
  DB_RESTORE
  HWM_INCONSISTENCY
  CORE_STATE_LOST
  MONITORING_INSUFFICIENT
  RECONCILE_INTERRUPTED
}

enum monitoring_status {
  PENDING
  VERIFIED
  STALE
  ERROR
}

// --- DB-004 reconciliation enums ---
enum btc_observation_status {
  MEMPOOL
  CONFIRMED
  REORG_REVERTED
  CONFLICTED
}

enum reconciliation_timing_class {
  ON_TIME
  LATE
  INDETERMINATE
}

enum reconciliation_amount_class {
  UNDERPAID
  EXACT
  OVERPAID
}

enum reconciliation_status {
  REVIEW_REQUIRED
  ACCEPTED
  REJECTED
}

enum reconciliation_action {
  DETECTED
  CONFIRMED
  ACCEPTED
  REJECTED
  NOTE_ADDED
  EXTERNAL_REFUND_RECORDED
  REORG_REVERTED
  REOPENED
}

enum reconciliation_actor_type {
  MERCHANT
  SYSTEM
}

// --- DB-005 wallet audit enums ---
enum wallet_audit_event_type {
  WALLET_CREATED
  WALLET_ROTATED
}

enum wallet_audit_actor_type {
  MERCHANT
  SYSTEM
  MIGRATION
}

// ============================================================================
// DB-001 - Merchant wallet + immutable version lineage
// ============================================================================

/// One custody root per merchant. Lineage is preserved (FK Restrict).
model merchant_wallets {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchant_id String   @unique @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  merchant users @relation(fields: [merchant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  versions            merchant_wallet_versions[]
  wallet_audit_events wallet_audit_events[]
}

/// Immutable descriptor version. Cryptographic fields never change after insert
/// (enforced by trigger); only lifecycle/retired_at transition ACTIVE -> RETIRED.
model merchant_wallet_versions {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchant_wallet_id  String             @db.Uuid
  version             Int
  descriptor          String
  descriptor_checksum String
  master_fingerprint  String
  derivation_path     String
  network             btc_network
  script_type         wallet_script_type @default(P2WPKH)
  lifecycle           wallet_lifecycle   @default(ACTIVE)
  activated_at        DateTime           @default(now()) @db.Timestamptz(6)
  retired_at          DateTime?          @db.Timestamptz(6)
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime           @updatedAt @db.Timestamptz(6)

  merchant_wallet merchant_wallets @relation(fields: [merchant_wallet_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  allocations        wallet_address_allocations[]
  recovery_state     merchant_wallet_recovery_state?
  monitoring         merchant_wallet_descriptor_monitoring?
  audit_from_version wallet_audit_events[]                  @relation("wallet_audit_from_version")
  audit_to_version   wallet_audit_events[]                  @relation("wallet_audit_to_version")

  @@unique([merchant_wallet_id, version], map: "uq_wallet_versions_wallet_version")
  @@unique([descriptor], map: "uq_wallet_versions_descriptor")
  @@index([merchant_wallet_id], map: "idx_wallet_versions_wallet_id")
}

// ============================================================================
// DB-002 - Address allocation ledger
// ============================================================================

/// Deterministic address derivation ledger. Each allocation is either attributed
/// to a payment (payment_id) or burned (burn_reason) - never both (XOR check).
model wallet_address_allocations {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_version_id String      @db.Uuid
  derivation_index  BigInt
  btc_address       String
  network           btc_network
  payment_id        String?     @unique @db.Uuid
  burn_reason       String?
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  assigned_at       DateTime?   @db.Timestamptz(6)

  wallet_version merchant_wallet_versions @relation(fields: [wallet_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payment        payments?                @relation(fields: [payment_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([wallet_version_id, derivation_index], map: "uq_allocations_version_index")
  @@unique([btc_address], map: "uq_allocations_btc_address")
  @@index([wallet_version_id], map: "idx_allocations_version_id")
}

// ============================================================================
// DB-003 - Recovery state + descriptor monitoring (1:1 with wallet version)
// ============================================================================

model merchant_wallet_recovery_state {
  wallet_version_id         String                @id @db.Uuid
  recovery_state            recovery_state        @default(RECOVERY_REQUIRED)
  state_reason              recovery_state_reason @default(INITIAL_ESTABLISHMENT)
  state_changed_at          DateTime              @default(now()) @db.Timestamptz(6)
  reconciliation_started_at DateTime?             @db.Timestamptz(6)
  lock_version              Int                   @default(0)
  created_at                DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                DateTime              @updatedAt @db.Timestamptz(6)

  wallet_version merchant_wallet_versions @relation(fields: [wallet_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model merchant_wallet_descriptor_monitoring {
  wallet_version_id       String            @id @db.Uuid
  monitoring_status       monitoring_status @default(PENDING)
  monitored_through_index BigInt?
  last_verified_at        DateTime?         @db.Timestamptz(6)
  last_error              String?
  lock_version            Int               @default(0)
  created_at              DateTime          @default(now()) @db.Timestamptz(6)
  updated_at              DateTime          @updatedAt @db.Timestamptz(6)

  wallet_version merchant_wallet_versions @relation(fields: [wallet_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// ============================================================================
// DB-004 - Payment reconciliation (lazy 1:1) + append-only audit trail
// ============================================================================

model payment_reconciliation {
  payment_id             String                      @id @db.Uuid
  timing_class           reconciliation_timing_class
  amount_class           reconciliation_amount_class
  reconciliation_status  reconciliation_status       @default(REVIEW_REQUIRED)
  business_first_seen_at DateTime?                   @db.Timestamptz(6)
  lock_version           Int                         @default(0)
  created_at             DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                    @updatedAt @db.Timestamptz(6)

  payment payments @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  audit_events reconciliation_audit_events[]
}

/// Append-only (enforced by trigger): no UPDATE, no DELETE.
model reconciliation_audit_events {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id    String                    @db.Uuid
  action        reconciliation_action
  actor_type    reconciliation_actor_type
  actor_user_id String?                   @db.Uuid
  note          String?
  created_at    DateTime                  @default(now()) @db.Timestamptz(6)

  reconciliation payment_reconciliation @relation(fields: [payment_id], references: [payment_id], onDelete: Cascade, onUpdate: NoAction)
  actor          users?                 @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([payment_id], map: "idx_reconciliation_audit_payment_id")
}

// ============================================================================
// DB-005 - Wallet audit events (append-only wallet lifecycle history)
// ============================================================================

/// Append-only (enforced by trigger). from/to versions must share the same
/// merchant_wallet_id (same-lineage trigger).
model wallet_audit_events {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchant_wallet_id     String                  @db.Uuid
  event_type             wallet_audit_event_type
  actor_type             wallet_audit_actor_type
  actor_user_id          String?                 @db.Uuid
  from_wallet_version_id String?                 @db.Uuid
  to_wallet_version_id   String?                 @db.Uuid
  reason_code            String?
  created_at             DateTime                @default(now()) @db.Timestamptz(6)

  merchant_wallet merchant_wallets          @relation(fields: [merchant_wallet_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  from_version    merchant_wallet_versions? @relation("wallet_audit_from_version", fields: [from_wallet_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  to_version      merchant_wallet_versions? @relation("wallet_audit_to_version", fields: [to_wallet_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor           users?                    @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([merchant_wallet_id], map: "idx_wallet_audit_wallet_id")
}
